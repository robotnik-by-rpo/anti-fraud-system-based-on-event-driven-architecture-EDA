# Docker-compose
NETWORK=... # Connecting to network into Docker-compose 

# Kafka
BROKER_ROLES=... # Broker's roles
API_BROKER=... # API for connecting into broker
PORTS_BROKER=... # Ports for connecting local and Docker envirement 
# Redis
PORTS_REDIS=... # Ports for connecting local and Docker envirement

# Postgresql
PORTS_POSTGRESQL=... # Ports for connecting local and Docker envirement
POSTGRES_USER=... # Login for connecting into DB PostgreSQL
POSTGRES_PASSWORD=... # Password for connecting into DB PostgreSQL
POSTGRES_DB=... # DB name for connecting DB PostgreSQL

